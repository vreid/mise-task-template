root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.{py,pyi,pyw}]
indent_size = 4

[*.{c,h,cpp,hpp,cs,rs}]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 8

# shfmt uses these exclusions for both formatting and shell-file discovery.
[**/{.git,node_modules,dist,build,coverage,target,bin,obj}/**]
ignore = true
